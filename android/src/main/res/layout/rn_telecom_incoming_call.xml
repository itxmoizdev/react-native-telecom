<?xml version="1.0" encoding="utf-8"?>
<!--
  Pixel / Material You style incoming call.
  Host apps can override via res/layout/rn_telecom_incoming_call.xml
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/rn_telecom_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#FFF7F4EF"
  android:fitsSystemWindows="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="28dp"
    android:paddingRight="28dp"
    android:paddingTop="72dp"
    android:paddingBottom="36dp">

    <TextView
      android:id="@+id/rn_telecom_caller_name"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center"
      android:textColor="#FF1C1B1F"
      android:textSize="34sp"
      android:textStyle="bold"
      android:maxLines="2"
      android:ellipsize="end" />

    <TextView
      android:id="@+id/rn_telecom_handle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:gravity="center"
      android:textColor="#FF49454F"
      android:textSize="16sp" />

    <TextView
      android:id="@+id/rn_telecom_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:gravity="center"
      android:text="Incoming call"
      android:textColor="#FF79747E"
      android:textSize="13sp"
      android:visibility="gone" />

    <View
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1" />

    <FrameLayout
      android:layout_width="168dp"
      android:layout_height="168dp"
      android:background="@drawable/rn_telecom_avatar_circle"
      android:clipToOutline="true">

      <TextView
        android:id="@+id/rn_telecom_avatar_initials"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="#FFFFFFFF"
        android:textSize="56sp"
        android:textStyle="bold" />

      <ImageView
        android:id="@+id/rn_telecom_avatar_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />
    </FrameLayout>

    <View
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1" />

    <TextView
      android:id="@+id/rn_telecom_message"
      android:layout_width="wrap_content"
      android:layout_height="40dp"
      android:layout_marginBottom="28dp"
      android:background="@drawable/rn_telecom_btn_message"
      android:drawablePadding="8dp"
      android:gravity="center"
      android:paddingLeft="18dp"
      android:paddingRight="18dp"
      android:text="Message"
      android:textAllCaps="false"
      android:textColor="#FF1C1B1F"
      android:textSize="14sp" />

    <!-- Bottom: Decline (red) + Answer (green) — tap only -->
    <LinearLayout
      android:id="@+id/rn_telecom_action_bar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center"
      android:orientation="horizontal"
      android:paddingLeft="12dp"
      android:paddingRight="12dp">

      <LinearLayout
        android:id="@+id/rn_telecom_decline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <FrameLayout
          android:layout_width="72dp"
          android:layout_height="72dp"
          android:background="@drawable/rn_telecom_decline_circle">

          <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/rn_telecom_ic_call_end"
            android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
          android:id="@+id/rn_telecom_decline_label"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:text="Decline"
          android:textColor="#FF1C1B1F"
          android:textSize="14sp" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/rn_telecom_answer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <FrameLayout
          android:layout_width="72dp"
          android:layout_height="72dp"
          android:background="@drawable/rn_telecom_answer_circle_green">

          <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/rn_telecom_ic_call_white"
            android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
          android:id="@+id/rn_telecom_answer_label"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:text="Answer"
          android:textColor="#FF1C1B1F"
          android:textSize="14sp" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
